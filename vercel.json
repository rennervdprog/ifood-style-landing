{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "itasuper.com.br" }
      ],
      "destination": "https://www.itasuper.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "(?<vhost>.*\\.vercel\\.app)" }
      ],
      "destination": "https://www.itasuper.com.br/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/store/:slug", "destination": "/api/store?slug=:slug" },
    {
      "source": "/:slug((?!api/|assets/|icon-|favicon|robots|sitemap|manifest|sw\\.js|registerSW\\.js|firebase-messaging-sw\\.js)[a-z0-9-]+)",
      "has": [
        { "type": "header", "key": "user-agent", "value": "(?i).*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|redditbot|Embedly|Applebot|Pinterest).*" }
      ],
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/blog/:slug",
      "has": [
        { "type": "header", "key": "user-agent", "value": "(?i).*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|redditbot|Embedly|Applebot|Pinterest|Googlebot|bingbot|DuckDuckBot|Baiduspider|YandexBot|Slurp|GPTBot|ClaudeBot|PerplexityBot).*" }
      ],
      "destination": "/api/og-blog?slug=:slug"
    },
    {
      "source": "/blog",
      "has": [
        { "type": "header", "key": "user-agent", "value": "(?i).*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|redditbot|Embedly|Applebot|Pinterest|Googlebot|bingbot|DuckDuckBot|Baiduspider|YandexBot|Slurp|GPTBot|ClaudeBot|PerplexityBot).*" }
      ],
      "destination": "/api/og-blog?type=index"
    },
    { "source": "/((?!api/|assets/|icon-|favicon|robots|sitemap|manifest|sw\\.js|registerSW\\.js|firebase-messaging-sw\\.js).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; img-src 'self' data: blob: https://qkjhguziuchqsbxzruea.supabase.co https://tile.openstreetmap.org https://images.unsplash.com https://www.transparenttextures.com https://api.qrserver.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://qkjhguziuchqsbxzruea.supabase.co wss://qkjhguziuchqsbxzruea.supabase.co https://lktzrqjvqoojlrhqnxuz.supabase.co https://nominatim.openstreetmap.org https://router.project-osrm.org https://viacep.com.br https://brasilapi.com.br https://fcmregistrations.googleapis.com https://firebaseinstallations.googleapis.com https://itasuper-c71a1.firebaseapp.com https://itasuper-c71a1.firebasestorage.app https://o4511668424998912.ingest.us.sentry.io https://vitals.vercel-insights.com; frame-src 'self' blob: https://qkjhguziuchqsbxzruea.supabase.co; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/store/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff2|woff|ttf|otf|svg|png|jpg|jpeg|webp|ico|gif)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/icon-(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}