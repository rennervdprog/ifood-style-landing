<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Fundo branco da Activity — evita faixa preta atrás do WebView
             quando o teclado abre e o body encolhe (Keyboard resize=Body). -->
        <item name="android:windowBackground">@android:color/white</item>
        <!-- 🔒 Edge-to-edge: permite que o app desenhe atrás das barras do sistema -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Status bar transparente: o header sticky do WebView desenha atrás
             dela e `env(safe-area-inset-top)` retorna o valor real do notch. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Android 12+ system splash: fundo laranja da marca + ícone do app -->
        <item name="windowSplashScreenBackground">@color/brand_orange</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- 🔒 Edge-to-edge na splash screen também -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

</resources>